{
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 0,
  "id": null,
  "links": [],
  "panels": [
    {
      "type": "stat",
      "title": "Cluster health (targets up)",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "targets": [{ "expr": "count(up == 1)", "refId": "A" }],
      "datasource": { "type": "prometheus", "uid": "prometheus" }
    },
    {
      "type": "stat",
      "title": "Coordinator RPS",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "targets": [{ "expr": "sum(rate(soa_http_requests_total{role=\"coordinator\"}[1m]))", "refId": "A" }],
      "datasource": { "type": "prometheus", "uid": "prometheus" }
    },
    {
      "type": "stat",
      "title": "Error rate",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "targets": [{ "expr": "sum(rate(soa_http_errors_total[1m]))", "refId": "A" }],
      "datasource": { "type": "prometheus", "uid": "prometheus" }
    },
    {
      "type": "stat",
      "title": "Replication lag (max)",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
      "targets": [{ "expr": "max(soa_replication_lag_seconds)", "refId": "A" }],
      "datasource": { "type": "prometheus", "uid": "prometheus" }
    },
    {
      "type": "timeseries",
      "title": "Latency p50 / p95 / p99 (coordinator + shards)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "targets": [
        { "expr": "histogram_quantile(0.50, sum(rate(soa_http_request_duration_seconds_bucket[1m])) by (le, role))", "legendFormat": "p50 {{role}}", "refId": "A" },
        { "expr": "histogram_quantile(0.95, sum(rate(soa_http_request_duration_seconds_bucket[1m])) by (le, role))", "legendFormat": "p95 {{role}}", "refId": "B" },
        { "expr": "histogram_quantile(0.99, sum(rate(soa_http_request_duration_seconds_bucket[1m])) by (le, role))", "legendFormat": "p99 {{role}}", "refId": "C" }
      ],
      "datasource": { "type": "prometheus", "uid": "prometheus" }
    },
    {
      "type": "timeseries",
      "title": "Throughput by service",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "targets": [
        { "expr": "sum(rate(soa_http_requests_total[1m])) by (service)", "legendFormat": "{{service}}", "refId": "A" }
      ],
      "datasource": { "type": "prometheus", "uid": "prometheus" }
    },
    {
      "type": "timeseries",
      "title": "Shard distribution (notes gauge)",
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 12 },
      "targets": [
        { "expr": "soa_shard_notes_total", "legendFormat": "{{service}}/{{instance}}", "refId": "A" }
      ],
      "datasource": { "type": "prometheus", "uid": "prometheus" }
    },
    {
      "type": "timeseries",
      "title": "In-flight requests",
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 12 },
      "targets": [
        { "expr": "soa_http_inflight_requests", "legendFormat": "{{service}}", "refId": "A" }
      ],
      "datasource": { "type": "prometheus", "uid": "prometheus" }
    }
  ],
  "schemaVersion": 39,
  "style": "dark",
  "tags": ["soa", "lab6"],
  "templating": { "list": [] },
  "time": { "from": "now-15m", "to": "now" },
  "title": "SOA Lab6 Observability",
  "uid": "soa-lab6",
  "version": 1
}
